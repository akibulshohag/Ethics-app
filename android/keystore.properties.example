# Copy to keystore.properties and set your real upload keystore passwords.
# cp keystore.properties.example keystore.properties
#
# Password must match the one used when eatwaze-upload.keystore was created.
# Do not commit keystore.properties.
MYAPP_UPLOAD_STORE_FILE=eatwaze-upload.keystore
MYAPP_UPLOAD_KEY_ALIAS=eatwaze-upload
MYAPP_UPLOAD_STORE_PASSWORD=your_store_password
MYAPP_UPLOAD_KEY_PASSWORD=your_key_password
